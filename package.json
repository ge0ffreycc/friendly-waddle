{
  "name": "desTop-plan-app",
  "version": "1.0.0",
  "description": "Win11 轻量级每日计划桌面应用，靠近桌面边缘可缩进",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.desktop.planapp",
    "productName": "每日计划",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "每日计划-v${version}.exe",
      "requestExecutionLevel": "user"
    }
  }
}
